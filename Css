body{
font-family:Arial;
margin:0;
background:#f5f5f5;
}
header{
background:#0b8f3c;
color:white;
text-align:center;
padding:20px;
}
nav{
background:white;
padding:15px;
text-align:center;
}
nav a{
margin:15px;
color:#0b8f3c;
font-weight:bold;
}
.products{
display:flex;
gap:20px;
padding:20px;
flex-wrap:wrap;
}
.card{
background:white;
padding:20px;
border-radius:15px;
box-shadow:0 2px 8px #ccc;
width:200px;
}
button{
background:#ff9f00;
color:white;
border:0;
padding:10px;
border-radius:8px;
}
